# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://localhost/smartcricket
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_HOURS=24

MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
MIN_VISIBILITY=0.5
UNCERTAIN_THRESHOLD=0.5

# Accounts with these emails become administrators (comma-separated)
ADMIN_EMAILS=
# Device for video models: cpu, mps (Apple GPU) or cuda
TORCH_DEVICE=cpu

# AI coach: openai or gemini. Leave the key empty to run without the coach.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For Gemini use e.g. LLM_PROVIDER=gemini and LLM_MODEL=gemini-3.8-flash
